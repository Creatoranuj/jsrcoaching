legacy-peer-deps=true
fund=false
audit=false
# Avoid the npm 10/11 "Exit handler never called" hang seen on Vercel
# when --no-audit/--no-fund are combined with --legacy-peer-deps in CLI flags.
# Centralising the flags here lets `npm install` run cleanly on Vercel.

# Pin the PUBLIC registry. Without this, an install run inside a sandbox that
# proxies npm (Replit's package-firewall.replit.local, Lovable's *.pkg.dev
# mirror) bakes those private absolute tarball URLs into package-lock.json /
# bun.lock. GitHub runners cannot resolve them, so every CI install dies with
# ConnectionRefused / EAI_AGAIN on the same few packages.
# Guarded in CI by `bun run check:lockfile`.
registry=https://registry.npmjs.org/
